<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exportar Tabelas para Excel" Height="380" Width="420" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F0F0F0">
    <Grid Margin="15">
        <StackPanel VerticalAlignment="Top">
            
            <!-- Seleção de Categoria -->
            <TextBlock Text="Selecione a Categoria:" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbCategories" Height="28" Margin="0,0,0,15"/>

            <!-- Filtro de Cabeçalho -->
            <TextBlock Text="Texto Procurado no Cabeçalho:" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtFiltro" Text="MC - " Height="25" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <!-- Opções Adicionais (Tags e Sufixo) -->
            <CheckBox x:Name="ChkTag" Content="Deseja inserir Tag?" Margin="0,0,0,10"/>
            
            <TextBlock Text="Sufixo (Opcional):" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtSufixo" Height="25" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <!-- Seleção de Arquivo Excel -->
            <TextBlock Text="Arquivo Excel de Destino:" FontWeight="Bold" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtExcelPath" Height="25" VerticalContentAlignment="Center" IsReadOnly="True" Grid.Column="0"/>
                <Button x:Name="BtnBrowse" Content="Procurar..." Height="25" Grid.Column="1" Margin="5,0,0,0"/>
            </Grid>

            <!-- Botões de Ação -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancelar" Content="Cancelar" Width="90" Height="30" Margin="0,0,10,0"/>
                <Button x:Name="BtnExportar" Content="Exportar" Width="90" Height="30" Background="#007ACC" Foreground="White" FontWeight="Bold"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>