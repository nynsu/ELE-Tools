<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerador Integrado de Vistas de Ambientes" Height="850" Width="430"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F0F0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Filtro -->
            <RowDefinition Height="Auto"/> <!-- Título Lista -->
            <RowDefinition Height="*"/>    <!-- Lista (Expande dinamicamente) -->
            <RowDefinition Height="Auto"/> <!-- Offset -->
            <RowDefinition Height="Auto"/> <!-- Tipo de Elevação -->
            <RowDefinition Height="Auto"/> <!-- Checkbox + Combo 2D -->
            <RowDefinition Height="Auto"/> <!-- Checkbox + Combo 3D -->
            <RowDefinition Height="Auto"/> <!-- Checkbox + Combo Elevações -->
            <RowDefinition Height="Auto"/> <!-- Checkbox Principal de Folha -->
            <RowDefinition Height="Auto"/> <!-- Painel de Destino das Folhas (Opcional) -->
            <RowDefinition Height="Auto"/> <!-- Botão Gerar -->
        </Grid.RowDefinitions>

        <!-- 1. Filtro por Nome do Ambiente -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Filtrar ambientes por nome:" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
            <TextBox x:Name="FilterTextBox" Height="22" FontSize="11" VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- 2. Título da Lista -->
        <TextBlock Grid.Row="1" Text="Selecione os ambientes (Segure CTRL para múltiplos):" 
                   FontWeight="Bold" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>

        <!-- 3. Lista de Ambientes -->
        <ListBox x:Name="RoomsListBox" Grid.Row="2" Margin="0,0,0,8" SelectionMode="Multiple" MinHeight="60">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding NameAndLevel}" Margin="1" FontSize="11"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 4. Campo de Offset -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Offset da Caixa de Corte (em centímetros):" FontWeight="Bold" FontSize="11" Margin="0,0,0,3"/>
            <TextBox x:Name="OffsetTextBox" Text="15" Height="22" VerticalContentAlignment="Center" FontSize="11"/>
        </StackPanel>

        <!-- 5. Escolha do Tipo de Elevação -->
        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Tipo de Elevação a Utilizar:" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
            <ComboBox x:Name="ElevationTypeComboBox" Height="22" FontSize="11" DisplayMemberPath="Name"/>
        </StackPanel>

        <!-- 6. Opção 2D (Planta) -->
        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <CheckBox x:Name="CreateFloorPlanCheckBox" Content="Criar Planta Baixa (2D)" IsChecked="True" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
            <TextBlock Text="Modelo de Vista (Planta):" FontSize="10" Margin="0,0,0,2" Foreground="#333"/>
            <ComboBox x:Name="FloorPlanTemplateComboBox" Height="22" FontSize="11" DisplayMemberPath="Name"/>
        </StackPanel>

        <!-- 7. Opção 3D -->
        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <CheckBox x:Name="Create3DCheckBox" Content="Criar Vista 3D" IsChecked="True" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
            <TextBlock Text="Modelo de Vista (3D):" FontSize="10" Margin="0,0,0,2" Foreground="#333"/>
            <ComboBox x:Name="View3DTemplateComboBox" Height="22" FontSize="11" DisplayMemberPath="Name"/>
        </StackPanel>

        <!-- 8. Opção Elevações Internas -->
        <StackPanel Grid.Row="7" Margin="0,0,0,8">
            <CheckBox x:Name="CreateElevationsCheckBox" Content="Criar Elevações Internas (4 Lados)" IsChecked="True" FontWeight="Bold" FontSize="11" Margin="0,0,0,2"/>
            <TextBlock Text="Modelo de Vista (Elevações):" FontSize="10" Margin="0,0,0,2" Foreground="#333"/>
            <ComboBox x:Name="ElevationTemplateComboBox" Height="22" FontSize="11" DisplayMemberPath="Name"/>
        </StackPanel>

        <!-- 9. Checkbox para habilitar inserção em folha -->
        <StackPanel Grid.Row="8" Margin="0,0,0,6">
            <CheckBox x:Name="PlaceOnSheetCheckBox" Content="Colocar vistas criadas em Folha" IsChecked="False" FontWeight="Bold" FontSize="11"/>
        </StackPanel>

        <!-- 10. Painel Condicional de Destino e Parâmetros (Oculto por padrão) -->
        <StackPanel x:Name="SheetOptionsPanel" Grid.Row="9" Margin="0,0,0,10" Visibility="Collapsed">
            <TextBlock Text="Modo de Destino:" FontSize="10" Margin="0,0,0,2" Foreground="#333"/>
            <ComboBox x:Name="SheetModeComboBox" Height="22" FontSize="11" Margin="0,0,0,6"/>

            <!-- Folha Existente -->
            <StackPanel x:Name="ExistingSheetPanel" Visibility="Collapsed" Margin="0,0,0,6">
                <TextBlock Text="Selecione a Folha Existente:" FontSize="10" Margin="0,0,0,2" Foreground="#333"/>
                <ComboBox x:Name="SheetComboBox" Height="22" FontSize="11" DisplayMemberPath="Name"/>
            </StackPanel>

            <!-- Nova Folha / Por Ambiente -->
            <StackPanel x:Name="NewSheetPanel" Visibility="Collapsed" Margin="0,0,0,6">
                <TextBlock Text="Família de Carimbo (Titleblock):" FontSize="10" Margin="0,0,0,2" Foreground="#333"/>
                <ComboBox x:Name="TitleBlockComboBox" Height="22" FontSize="11" DisplayMemberPath="Name" Margin="0,0,0,4"/>
                
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock Text="Número / Prefixo:" FontSize="10" Margin="0,0,0,2" Foreground="#333"/>
                        <TextBox x:Name="NewSheetNumberTextBox" Height="22" FontSize="11" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <StackPanel x:Name="NewSheetNameStack" Margin="4,0,0,0">
                        <TextBlock Text="Nome da Folha:" FontSize="10" Margin="0,0,0,2" Foreground="#333"/>
                        <TextBox x:Name="NewSheetNameTextBox" Height="22" FontSize="11" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>

            <!-- Parâmetros Sim/Não Dinâmicos da Família do Carimbo -->
            <StackPanel x:Name="SheetParametersPanel" Margin="0,4,0,0" Visibility="Collapsed">
                <TextBlock Text="Parâmetros de Instância da Família (Sim/Não):" FontSize="10" FontWeight="Bold" Margin="0,0,0,2" Foreground="#333"/>
                <ListBox x:Name="ParametersListBox" Height="70" SelectionMode="Multiple">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" FontSize="11" Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>

        <!-- 11. Botão de Confirmação Final -->
        <Button x:Name="SelectButton" Grid.Row="10" Content="Gerar Vistas Selecionadas" Height="30" 
                Click="SelectButton_Click" Background="#007ACC" Foreground="White" 
                FontWeight="Bold" FontSize="11" Cursor="Hand"/>
    </Grid>
</Window>